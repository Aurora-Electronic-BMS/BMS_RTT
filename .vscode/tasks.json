{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Bootloader",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/CMake/bin/cmake.exe",
            "args": ["--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}/Bootloader_test",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;D:/STM32CubeCLT_1.18.0/Ninja/bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build Bootloader",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/CMake/bin/cmake.exe",
            "args": ["--build", "--preset", "Debug", "--parallel"],
            "options": {
                "cwd": "${workspaceFolder}/Bootloader_test",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;D:/STM32CubeCLT_1.18.0/Ninja/bin;${env:PATH}"
                }
            },
            "dependsOn": "Configure Bootloader",
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean Bootloader",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/CMake/bin/cmake.exe",
            "args": ["--build", "--preset", "Debug", "--target", "clean"],
            "options": {
                "cwd": "${workspaceFolder}/Bootloader_test",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;D:/STM32CubeCLT_1.18.0/Ninja/bin;${env:PATH}"
                }
            },
            "dependsOn": "Configure Bootloader",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Flash Bootloader (0x08000000)",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD", "mode=UR", "reset=HWrst",
                "-w", "${workspaceFolder}/Bootloader_test/build/Debug/Bootloader_test.bin",
                "0x08000000", "-v", "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;${env:PATH}"
                }
            },
            "dependsOn": "Build Bootloader",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Configure Firmware",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/CMake/bin/cmake.exe",
            "args": ["--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}/APP_test",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;D:/STM32CubeCLT_1.18.0/Ninja/bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build Firmware",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/CMake/bin/cmake.exe",
            "args": ["--build", "--preset", "Debug", "--parallel"],
            "options": {
                "cwd": "${workspaceFolder}/APP_test",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;D:/STM32CubeCLT_1.18.0/Ninja/bin;${env:PATH}"
                }
            },
            "dependsOn": "Configure Firmware",
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean Firmware",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/CMake/bin/cmake.exe",
            "args": ["--build", "--preset", "Debug", "--target", "clean"],
            "options": {
                "cwd": "${workspaceFolder}/APP_test",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;D:/STM32CubeCLT_1.18.0/Ninja/bin;${env:PATH}"
                }
            },
            "dependsOn": "Configure Firmware",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Flash Firmware (0x08010000)",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD", "mode=UR", "reset=HWrst",
                "-w", "${workspaceFolder}/APP_test/build/Debug/APP_test.bin",
                "0x08010000", "-v", "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;${env:PATH}"
                }
            },
            "dependsOn": "Build Firmware",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build All",
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": ["Build Bootloader", "Build Firmware"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Flash All (Bootloader + Firmware)",
            "dependsOn": ["Flash Bootloader (0x08000000)", "Flash Firmware (0x08010000)"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "IAP 串口升级 APP (BMS 协议)",
            "type": "process",
            "command": "python",
            "args": ["tools/iap_host_bms.py", "--port", "COM7", "--bin", "${workspaceFolder}/APP_test/build/Debug/APP_test.bin"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Open IAP GUI (BMS)",
            "type": "process",
            "command": "python",
            "args": ["tools/iap_host_bms_gui.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Reset via ST-Link (Hard Reset)",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": ["-c", "port=SWD", "mode=UR", "reset=HWrst"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Read Flash Dumps (BL + APP + Flags)",
            "type": "process",
            "command": "D:/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD", "mode=UR",
                "-r32", "0x08000000", "8",
                "-r32", "0x08010000", "8",
                "-r32", "0x080FFE00", "1",
                "-r32", "0x080FFF00", "5"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        }
    ]
}
