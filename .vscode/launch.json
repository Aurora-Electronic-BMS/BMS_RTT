{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug APP (OpenOCD)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}/APP",
            "executable": "${workspaceFolder}/APP/build/Debug/BMS_RTT.elf",
            "device": "STM32F407VG",
            "gdbPath": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "serverpath": "D:/OpenOCD-20240916-0.12.0/bin/openocd.exe",
            "searchDir": [
                "D:/OpenOCD-20240916-0.12.0/share/openocd/scripts"
            ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "preLaunchTask": "Build Firmware",
            "postLaunchCommands": [
                "set {unsigned int}0xE000ED08 = 0x08010000",
                "set $sp = *(unsigned int *)0x08010000",
                "set $pc = *(unsigned int *)0x08010004"
            ],
            "overrideRestartCommands": [
                "monitor reset halt",
                "set {unsigned int}0xE000ED08 = 0x08010000",
                "set $sp = *(unsigned int *)0x08010000",
                "set $pc = *(unsigned int *)0x08010004"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug Bootloader (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}/Bootloader",
            "executable": "${workspaceFolder}/Bootloader/build/Debug/Bootloader.elf",
            "device": "STM32F407VG",
            "gdbPath": "D:/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "serverpath": "D:/OpenOCD-20240916-0.12.0/bin/openocd.exe",
            "searchDir": [
                "D:/OpenOCD-20240916-0.12.0/share/openocd/scripts"
            ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "preLaunchTask": "Build Bootloader",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}
